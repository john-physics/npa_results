# =========================================
# NPA RESULTS - APACHE CONFIGURATION
# =========================================

RewriteEngine On


# =========================================
# 0. APPLICATION ENVIRONMENT
# =========================================

#
# DEVELOPMENT = no browser caching
# PRODUCTION  = long-term static asset caching
#
# Change ONLY this line when deploying.
#

# SetEnv APP_ENV development

SetEnv APP_ENV production


# =========================================
# 1. ERROR PAGES
# =========================================

ErrorDocument 403 /403.shtml
ErrorDocument 404 /404.shtml


# ============================================================
# STATIC ASSET CACHING
# ============================================================

<IfModule mod_headers.c>

    # --------------------------------------------------------
    # DEVELOPMENT MODE
    # --------------------------------------------------------
    #
    # DO NOT CACHE CSS / JS / IMAGES / FONTS DURING DEVELOPMENT.
    #

    <FilesMatch "\.(css|js|jpg|jpeg|png|webp|gif|svg|ico|woff|woff2|ttf|otf)$">

        Header always unset Cache-Control
        Header always unset Expires
        Header always unset Pragma

        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"

    </FilesMatch>


    # --------------------------------------------------------
    # SERVICE WORKER
    # --------------------------------------------------------
    #
    # sw.js must ALWAYS be checked for updates.
    #

    <Files "npa-sw.js">

        Header always unset Cache-Control
        Header always unset Expires
        Header always unset Pragma

        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"

    </Files>

</IfModule>


# ============================================================
# 3. DISABLE MULTIVIEWS
# ============================================================

Options -MultiViews


# ============================================================
# 4. BLOCK DIRECT PHP REQUESTS
# ============================================================

RewriteCond %{THE_REQUEST} \s/+[^\s?]*\.php(?:[?\s]|$) [NC]
RewriteRule ^ - [F,L]


# ============================================================
# 5. ALLOW REAL STATIC FILES
# ============================================================

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]


# ============================================================
# 6. ALLOW REAL DIRECTORIES
# ============================================================

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]


# ============================================================
# 7. SINGLE APPLICATION ROUTER
# ============================================================

RewriteRule ^ index.php [L,QSA]